# Copie para `.env.local` e preencha os valores.
# Nunca comite `.env.local`: ele contém segredos.
OPENCODE_GO_API_KEY=sua-chave-aqui
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
JARVIS_MODEL=deepseek-v4.1-flash

# Opcional: acesso remoto com login.
APP_PASSWORD=
JARVIS_PUBLIC_ORIGIN=

# Opcional: Obsidian e modelos alternativos.
OBSIDIAN_VAULT_PATH=
JARVIS_VISION_MODEL=deepseek-v4.1-flash
JARVIS_TTS_VOICE=pt-BR-AntonioNeural
JARVIS_TTS_RATE=+0%
JARVIS_TTS_PYTHON=.jarvis/tts-venv/Scripts/python.exe
JARVIS_WORKSPACE_ROOT=

# Opcional: Supabase no lugar do SQLite local.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
